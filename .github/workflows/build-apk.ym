
name: Build nVinhx NoVa APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check source
        run: |
          find . -maxdepth 4 -type f | head -100
          echo "Source files checked"

      - name: Prepare build info
        run: |
          echo "Repository downloaded successfully"
          echo "Check Android Gradle project before building APK"
